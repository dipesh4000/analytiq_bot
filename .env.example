# Required
BOT_API_KEY=123456789:replace_with_botfather_token
OPENROUTER_API_KEY=replace_with_openrouter_key
TAVILY_API_KEY=replace_with_tavily_key

# Only zero-cost OpenRouter IDs are accepted. Use openrouter/free or :free IDs.
LLM_MODELS=openrouter/free

# Local mode: polling. Production mode: webhook.
BOT_MODE=polling
PUBLIC_BASE_URL=http://localhost:8000
TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_numbers_dash_or_underscore

# Runtime tuning
DATA_DIR=data
SESSION_TTL_SECONDS=900
MAX_AGENT_STEPS=8
AGENT_TIMEOUT_SECONDS=180
MAX_CONCURRENT_RUNS=3
PORT=8000
